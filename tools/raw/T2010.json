{
 "work": "T2010",
 "title": "信心銘",
 "byline": "隋 僧璨作",
 "file": "T48n2010",
 "source": "CBETA T48n2010",
 "url": "https://cbetaonline.dila.edu.tw/zh/T48n2010",
 "license": "CC BY-NC-SA 4.0 — CBETA 電子佛典集成 (https://cbeta.org/copyright)",
 "fetchedAt": "2026-09-27",
 "juans": [
  {
   "juan": 1,
   "blocks": [
    {
     "lb": "T48n2010_p0376b17",
     "kind": "p",
     "text": "No. 2010"
    },
    {
     "lb": "T48n2010_p0376b18",
     "kind": "head",
     "text": "信心銘"
    },
    {
     "lb": "T48n2010_p0376b20",
     "kind": "verse",
     "text": "至道無難 唯嫌揀擇 但莫憎愛"
    },
    {
     "lb": "T48n2010_p0376b21",
     "kind": "verse",
     "text": "洞然明白 毫釐有差 天地懸隔"
    },
    {
     "lb": "T48n2010_p0376b22",
     "kind": "verse",
     "text": "欲得現前 莫存順逆 違順相爭"
    },
    {
     "lb": "T48n2010_p0376b23",
     "kind": "verse",
     "text": "是為心病 不識玄旨 徒勞念靜"
    },
    {
     "lb": "T48n2010_p0376b24",
     "kind": "verse",
     "text": "圓同太虛 無欠無餘 良由取捨"
    },
    {
     "lb": "T48n2010_p0376b25",
     "kind": "verse",
     "text": "所以不如 莫逐有緣 勿住空忍"
    },
    {
     "lb": "T48n2010_p0376b26",
     "kind": "verse",
     "text": "一種平懷 泯然自盡 止動歸止"
    },
    {
     "lb": "T48n2010_p0376b27",
     "kind": "verse",
     "text": "止更彌動 唯滯兩邊 寧知一種"
    },
    {
     "lb": "T48n2010_p0376b28",
     "kind": "verse",
     "text": "一種不通 兩處失功 遣有沒有"
    },
    {
     "lb": "T48n2010_p0376b29",
     "kind": "verse",
     "text": "從空背空 多言多慮 轉不相應"
    },
    {
     "lb": "T48n2010_p0376c01",
     "kind": "verse",
     "text": "絕言絕慮 無處不通 歸根得旨"
    },
    {
     "lb": "T48n2010_p0376c02",
     "kind": "verse",
     "text": "隨照失宗 須臾返照 勝却前空"
    },
    {
     "lb": "T48n2010_p0376c03",
     "kind": "verse",
     "text": "前空轉變 皆由妄見 不用求真"
    },
    {
     "lb": "T48n2010_p0376c04",
     "kind": "verse",
     "text": "唯須息見 二見不住 慎勿追尋"
    },
    {
     "lb": "T48n2010_p0376c05",
     "kind": "verse",
     "text": "纔有是非 紛然失心 二由一有"
    },
    {
     "lb": "T48n2010_p0376c06",
     "kind": "verse",
     "text": "一亦莫守 一心不生 萬法無咎"
    },
    {
     "lb": "T48n2010_p0376c07",
     "kind": "verse",
     "text": "無咎無法 不生不心 能隨境滅"
    },
    {
     "lb": "T48n2010_p0376c08",
     "kind": "verse",
     "text": "境逐能沈 境由能境 能由境能"
    },
    {
     "lb": "T48n2010_p0376c09",
     "kind": "verse",
     "text": "欲知兩段 元是一空 一空同兩"
    },
    {
     "lb": "T48n2010_p0376c10",
     "kind": "verse",
     "text": "齊含萬像 不見精麁 寧有偏黨"
    },
    {
     "lb": "T48n2010_p0376c11",
     "kind": "verse",
     "text": "大道體寬 無易無難 小見狐疑"
    },
    {
     "lb": "T48n2010_p0376c12",
     "kind": "verse",
     "text": "轉急轉遲 執之失度 心入邪路"
    },
    {
     "lb": "T48n2010_p0376c13",
     "kind": "verse",
     "text": "放之自然 體無去住 任性合道"
    },
    {
     "lb": "T48n2010_p0376c14",
     "kind": "verse",
     "text": "逍遙絕惱 繫念乖真 沈惛不好"
    },
    {
     "lb": "T48n2010_p0376c15",
     "kind": "verse",
     "text": "不好勞神 何用疎親 欲趣一乘"
    },
    {
     "lb": "T48n2010_p0376c16",
     "kind": "verse",
     "text": "勿惡六塵 六塵不惡 還同正覺"
    },
    {
     "lb": "T48n2010_p0376c17",
     "kind": "verse",
     "text": "智者無為 愚人自縛 法無異法"
    },
    {
     "lb": "T48n2010_p0376c18",
     "kind": "verse",
     "text": "妄自愛著 將心用心 豈非大錯"
    },
    {
     "lb": "T48n2010_p0376c19",
     "kind": "verse",
     "text": "迷生寂亂 悟無好惡 一切二邊"
    },
    {
     "lb": "T48n2010_p0376c20",
     "kind": "verse",
     "text": "妄自斟酌 夢幻空華 何勞把捉"
    },
    {
     "lb": "T48n2010_p0376c21",
     "kind": "verse",
     "text": "得失是非 一時放却 眼若不眠"
    },
    {
     "lb": "T48n2010_p0376c22",
     "kind": "verse",
     "text": "諸夢自除 心若不異 萬法一如"
    },
    {
     "lb": "T48n2010_p0376c23",
     "kind": "verse",
     "text": "一如體玄 兀爾忘緣 萬法齊觀"
    },
    {
     "lb": "T48n2010_p0376c24",
     "kind": "verse",
     "text": "歸復自然 泯其所以 不可方比"
    },
    {
     "lb": "T48n2010_p0376c25",
     "kind": "verse",
     "text": "止動無動 動止無止 兩既不成"
    },
    {
     "lb": "T48n2010_p0376c26",
     "kind": "verse",
     "text": "一何有爾 究竟窮極 不存軌則"
    },
    {
     "lb": "T48n2010_p0376c27",
     "kind": "verse",
     "text": "啟心平等 所作俱息 狐疑盡淨"
    },
    {
     "lb": "T48n2010_p0376c28",
     "kind": "verse",
     "text": "正信調直 一切不留 無可記憶"
    },
    {
     "lb": "T48n2010_p0376c29",
     "kind": "verse",
     "text": "虛明自然 不勞心力 非思量處"
    },
    {
     "lb": "T48n2010_p0377a01",
     "kind": "verse",
     "text": "識情難測 真如法界 無他無自"
    },
    {
     "lb": "T48n2010_p0377a02",
     "kind": "verse",
     "text": "要急相應 唯言不二 不二皆同"
    },
    {
     "lb": "T48n2010_p0377a03",
     "kind": "verse",
     "text": "無不包容 十方智者 皆入此宗"
    },
    {
     "lb": "T48n2010_p0377a04",
     "kind": "verse",
     "text": "宗非促延(一念萬年萬年一念) 無在不在"
    },
    {
     "lb": "T48n2010_p0377a05",
     "kind": "verse",
     "text": "十方目前 極小同大 妄絕境界"
    },
    {
     "lb": "T48n2010_p0377a06",
     "kind": "verse",
     "text": "極大同小 不見邊表 有即是無"
    },
    {
     "lb": "T48n2010_p0377a07",
     "kind": "verse",
     "text": "無即是有 若不如是 必不須守"
    },
    {
     "lb": "T48n2010_p0377a08",
     "kind": "verse",
     "text": "一即一切 一切即一 但能如是"
    },
    {
     "lb": "T48n2010_p0377a09",
     "kind": "verse",
     "text": "何慮不畢 信心不二 不二信心"
    },
    {
     "lb": "T48n2010_p0377a10",
     "kind": "verse",
     "text": "言語道斷 非去來今"
    },
    {
     "lb": "T48n2010_p0377a11",
     "kind": "head",
     "text": "信心銘之終"
    }
   ]
  }
 ]
}